# BasicCapitalFlow

main: kit: flow: BasicCapitalFlow:
{
  entity: "capital",
  kind: "basic",
  name: "BasicCapitalFlow",
  step: [
    {
      input: {
        ref: "capital_ref01",
        srcdatavar: "capital_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "capital01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-capital_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCapitalFlow"
}